# Ejemplo de variables para servidor/producción. Usa secretos reales fuera del repositorio.
# Perfil y base de datos
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/barberia_db?useSSL=true&serverTimezone=America/Bogota
DB_USERNAME=rand_app
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# Orígenes exactos separados por comas; vacío cuando frontend y API comparten origen.
ALLOWED_ORIGINS=https://tu-dominio.example

# Creación o rotación puntual del primer administrador. Déjalo en false después.
BOOTSTRAP_ADMIN=false
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_ADMIN_TELEFONO=

# Límites de abuso
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
PUBLIC_WRITE_MAX_REQUESTS=30
PUBLIC_WRITE_WINDOW_MINUTES=1
